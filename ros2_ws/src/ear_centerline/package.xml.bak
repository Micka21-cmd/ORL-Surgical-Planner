<?xml version="1.0"?>
<package format="3">
<name>ear_centerline</name>
<version>0.0.1</version>
<description>Centerline & SDF computation</description>
<maintainer email="you@example.com">you</maintainer>
<license>MIT</license>
<buildtool_depend>ament_cmake</buildtool_depend>
<depend>rclpy</depend>
<depend>geometry_msgs</depend>
<exec_depend>python3-numpy</exec_depend>
<exec_depend>python3-nibabel</exec_depend>
<exec_depend>python3-scipy</exec_depend>
<exec_depend>python3-scikit-image</exec_depend>
</package>